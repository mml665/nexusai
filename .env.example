# NexusAI Environment Configuration
# Copy to .env and fill in your values

# ── LLM Configuration ──
OPENAI_API_KEY=your-api-key-here
LLM_MODEL=qwen3.7-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding

# ── Auth ──
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_EXPIRE_MINUTES=1440

# ── CORS (comma-separated origins) ──
CORS_ORIGINS=http://localhost:3000,http://localhost:80,http://localhost:5173

# ── Infrastructure (defaults work with docker-compose) ──
REDIS_URL=redis://redis:6379
DATABASE_URL=postgresql://nexusai:nexusai123@postgres:5432/nexusai
ES_URL=http://elasticsearch:9200

# ── Simulator ──
PUSH_INTERVAL=1.0

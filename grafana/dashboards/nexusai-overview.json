        { "expr": "nexusai_circuit_breaker_state", "legendFormat": "{{service}}", "refId": "A" }
      ],
      "title": "熔断器状态",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "请求成功率（2xx / 总请求）",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "green", "value": 0.95 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 20 },
      "id": 13,
      "options": { "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [
        { "expr": "sum(rate(nexusai_http_requests_total{status=~\"2..\"}[5m])) / clamp_min(sum(rate(nexusai_http_requests_total[5m])), 1)", "legendFormat": "成功率", "refId": "A" }
      ],
      "title": "请求成功率",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "设备总数与运行状态",

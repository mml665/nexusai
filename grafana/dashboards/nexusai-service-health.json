    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "采集失败次数统计，非零表示有采集异常",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
